{
  "manifest_version": 3,
  "name": "Bilibili 线程撕裂者",
  "short_name": "线程撕裂者",
  "version": "0.9.4.3",
  "description": "保留哔哩哔哩原生播放器，通过多 CDN、多 Range 并发下载改善视频缓冲速度。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "线程撕裂者设置（在 B 站页面上点击）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/cdn-resolver.js",
        "src/sidx.js",
        "src/idm-downloader.js",
        "src/native-mse-player.js",
        "src/native-range-transport.js",
        "src/runtime-notices.js",
        "src/settings-panel.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/cdn-resolver.js",
        "src/live-core.js",
        "src/runtime-notices.js",
        "src/settings-panel.js",
        "src/live-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/range-core.js",
        "src/cdn-resolver.js",
        "src/settings-panel.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/notification-view.js",
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/notification-view.js",
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
